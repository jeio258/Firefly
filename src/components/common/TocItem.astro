---
import type { TocItem } from "@/utils/toc-shared";

interface Props {
	item: TocItem;
}
const { item } = Astro.props;
---

<a
	href={item.href}
	class={`toc-item toc-level-${item.depthLevel}`}
	data-heading-id={item.headingId}
	aria-label={item.text}
	title={item.text}
>
	<div class={`toc-badge ${item.badgeKind === "index" ? "toc-badge-index" : ""}`}>
		{item.badgeKind === "index" ? (
			item.badgeIndex
		) : item.badgeKind === "dot" ? (
			<span class="toc-badge-dot"></span>
		) : (
			<span class="toc-badge-dot toc-badge-dot-sm"></span>
		)}
	</div>
	<div class={`toc-label ${item.labelPrimary ? "toc-label-primary" : "toc-label-secondary"}`}>
		{item.text}
	</div>
</a>
